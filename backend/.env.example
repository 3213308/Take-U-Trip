# LLM 配置
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL_NAME=deepseek-chat

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# 适配器模式：mock / real
ADAPTER_MODE=mock

# 数据库
DB_URL=sqlite:///./take_u_trip.db

# ReAct 循环配置
MAX_ITERATIONS=8

# 工具缓存 TTL（秒）
TOOL_CACHE_TTL=3600
